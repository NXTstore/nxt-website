<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NXT | The Next One</title>
  <meta name="description" content="NXT clothing — clean essentials for the next generation.">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header>
    <a class="logo" href="#home">NXT<span>.</span></a>
    <nav>
      <a href="#shop">Shop</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
    <button class="cart-btn" id="cartBtn" aria-label="Open cart">Bag <span id="cartCount">0</span></button>
  </header>

  <main>
    <section class="hero" id="home">
      <p class="eyebrow">NXT DROP 01</p>
      <h1>WEAR<br>WHAT'S <em>NXT.</em></h1>
      <p class="hero-copy">Premium everyday pieces built for the next move.</p>
      <a class="button" href="#shop">Shop the drop</a>
    </section>

    <section class="section" id="shop">
      <div class="section-head">
        <div>
          <p class="eyebrow">THE COLLECTION</p>
          <h2>Shop NXT</h2>
        </div>
        <p>Simple. Clean. Made to move.</p>
      </div>
      <div class="products">
        <article class="product">
          <div class="product-image aqua"><span>NXT</span></div>
          <h3>Aqua Logo Tee</h3><p>$45.00</p>
          <button class="add" data-product="Aqua Logo Tee" data-price="45">Add to bag</button>
        </article>
        <article class="product">
          <div class="product-image white"><span>NXT</span></div>
          <h3>Essential Hoodie</h3><p>$85.00</p>
          <button class="add" data-product="Essential Hoodie" data-price="85">Add to bag</button>
        </article>
        <article class="product">
          <div class="product-image dark"><span>NXT</span></div>
          <h3>Core Cap</h3><p>$35.00</p>
          <button class="add" data-product="Core Cap" data-price="35">Add to bag</button>
        </article>
      </div>
    </section>

    <section class="about" id="about">
      <div><p class="eyebrow">ABOUT NXT</p><h2>BUILT FOR<br>THE <em>NEXT.</em></h2></div>
      <p>NXT is about moving forward. We make clean, wearable clothing with a sharp aqua-and-white identity for people ready for whatever comes next.</p>
    </section>

    <section class="contact" id="contact">
      <p class="eyebrow">GET IN TOUCH</p>
      <h2>Let's talk.</h2>
      <p>Questions, support or collaborations?</p>
      <a class="email" href="mailto:nxtonestore@gmail.com">nxtonestore@gmail.com</a>
    </section>
  </main>

  <aside class="cart" id="cart">
    <button class="close" id="closeCart">×</button>
    <p class="eyebrow">YOUR BAG</p>
    <div id="cartItems"><p class="empty">Your bag is empty.</p></div>
    <div class="cart-footer"><strong>Total: $<span id="total">0.00</span></strong><button class="button" id="checkout">Checkout</button></div>
  </aside>

  <footer>© 2026 NXT. ALL RIGHTS RESERVED.</footer>
  <script src="script.js"></script>
</body>
</html>
