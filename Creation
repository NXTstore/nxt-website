<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NXT | The Next One</title>
  <meta name="description" content="NXT clothing — clean essentials for the next generation.">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header>
    <a class="logo" href="#home">NXT<span>.</span></a>
    <nav>
      <a href="#shop">Shop</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
    <button class="cart-btn" id="cartBtn" aria-label="Open cart">Bag <span id="cartCount">0</span></button>
  </header>

  <main>
    <section class="hero" id="home">
      <p class="eyebrow">NXT DROP 01</p>
      <h1>WEAR<br>WHAT'S <em>NXT.</em></h1>
      <p class="hero-copy">Premium everyday pieces built for the next move.</p>
      <a class="button" href="#shop">Shop the drop</a>
    </section>

    <section class="section" id="shop">
      <div class="section-head">
        <div>
          <p class="eyebrow">THE COLLECTION</p>
          <h2>Shop NXT</h2>
        </div>
        <p>Simple. Clean. Made to move.</p>
      </div>
      <div class="products">
        <article class="product">
          <div class="product-image aqua"><span>NXT</span></div>
          <h3>Aqua Logo Tee</h3><p>$45.00</p>
          <button class="add" data-product="Aqua Logo Tee" data-price="45">Add to bag</button>
        </article>
        <article class="product">
          <div class="product-image white"><span>NXT</span></div>
          <h3>Essential Hoodie</h3><p>$85.00</p>
          <button class="add" data-product="Essential Hoodie" data-price="85">Add to bag</button>
        </article>
        <article class="product">
          <div class="product-image dark"><span>NXT</span></div>
          <h3>Core Cap</h3><p>$35.00</p>
          <button class="add" data-product="Core Cap" data-price="35">Add to bag</button>
        </article>
      </div>
    </section>

    <section class="about" id="about">
      <div><p class="eyebrow">ABOUT NXT</p><h2>BUILT FOR<br>THE <em>NEXT.</em></h2></div>
      <p>NXT is about moving forward. We make clean, wearable clothing with a sharp aqua-and-white identity for people ready for whatever comes next.</p>
    </section>

    <section class="contact" id="contact">
      <p class="eyebrow">GET IN TOUCH</p>
      <h2>Let's talk.</h2>
      <p>Questions, support or collaborations?</p>
      <a class="email" href="mailto:nxtonestore@gmail.com">nxtonestore@gmail.com</a>
    </section>
  </main>

  <aside class="cart" id="cart">
    <button class="close" id="closeCart">×</button>
    <p class="eyebrow">YOUR BAG</p>
    <div id="cartItems"><p class="empty">Your bag is empty.</p></div>
    <div class="cart-footer"><strong>Total: $<span id="total">0.00</span></strong><button class="button" id="checkout">Checkout</button></div>
  </aside>

  <footer>© 2026 NXT. ALL RIGHTS RESERVED.</footer>
  <script src="script.js"></script>
</body>
</html>

const cart=[];const cartEl=document.getElementById('cart');const itemsEl=document.getElementById('cartItems');const countEl=document.getElementById('cartCount');const totalEl=document.getElementById('total');
document.getElementById('cartBtn').onclick=()=>cartEl.classList.add('open');
document.getElementById('closeCart').onclick=()=>cartEl.classList.remove('open');
document.querySelectorAll('.add').forEach(btn=>btn.onclick=()=>{cart.push({name:btn.dataset.product,price:Number(btn.dataset.price)});render();cartEl.classList.add('open')});
function render(){countEl.textContent=cart.length;if(!cart.length){itemsEl.innerHTML='<p class="empty">Your bag is empty.</p>';totalEl.textContent='0.00';return}itemsEl.innerHTML=cart.map((x,i)=>`<div class="cart-item"><span>${x.name}</span><strong>$${x.price.toFixed(2)}</strong></div>`).join('');totalEl.textContent=cart.reduce((s,x)=>s+x.price,0).toFixed(2)}
document.getElementById('checkout').onclick=()=>alert('Checkout is a demo in this version. Connect a payment provider such as Stripe or Shopify before taking real orders.');

*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Arial,Helvetica,sans-serif;color:#101313;background:#fff}header{height:74px;display:flex;align-items:center;justify-content:space-between;padding:0 6%;border-bottom:1px solid #e7eeee;position:sticky;top:0;background:rgba(255,255,255,.95);z-index:5;backdrop-filter:blur(10px)}.logo{font-size:30px;font-weight:900;letter-spacing:-2px;color:#101313;text-decoration:none}.logo span{color:#19e6dc}nav{display:flex;gap:28px}nav a{color:#101313;text-decoration:none;font-size:14px;font-weight:bold}.cart-btn,.add,.close{border:0;background:none;font:inherit;cursor:pointer}.cart-btn{font-weight:bold}.cart-btn span{background:#19e6dc;border-radius:20px;padding:4px 8px;margin-left:5px}.hero{min-height:640px;padding:10% 8%;background:linear-gradient(135deg,#101313 0%,#101313 60%,#19e6dc 60%);color:white}.eyebrow{font-size:11px;letter-spacing:2px;font-weight:bold;margin:0 0 18px;color:#19e6dc}.hero h1,.about h2,.section h2,.contact h2{font-size:clamp(48px,9vw,120px);line-height:.85;letter-spacing:-6px;margin:0;font-weight:900}.hero em,.about em{font-style:normal;color:#19e6dc}.hero-copy{max-width:400px;font-size:18px;line-height:1.5;margin:30px 0}.button{display:inline-block;background:#19e6dc;color:#101313;border:0;padding:15px 23px;font-weight:bold;text-decoration:none;cursor:pointer}.section{padding:100px 8%}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:40px}.section h2,.contact h2{font-size:60px}.products{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.product-image{height:330px;display:flex;align-items:center;justify-content:center;font-size:80px;font-weight:900;letter-spacing:-8px;margin-bottom:16px}.aqua{background:#19e6dc}.white{background:#f2f7f7;border:1px solid #e2eaea}.dark{background:#101313;color:#19e6dc}.product h3{margin:0 0 7px}.product p{margin:0 0 12px;color:#657171}.add{background:#101313;color:white;padding:12px 18px;width:100%;font-weight:bold}.about{background:#19e6dc;padding:100px 8%;display:grid;grid-template-columns:1fr 1fr;gap:80px}.about p:last-child{font-size:23px;line-height:1.5;max-width:540px}.contact{text-align:center;padding:120px 8%}.email{font-size:clamp(22px,4vw,54px);font-weight:900;color:#101313;text-decoration:none;border-bottom:4px solid #19e6dc}footer{padding:30px 8%;background:#101313;color:white;font-size:11px;letter-spacing:1px}.cart{position:fixed;right:-430px;top:0;width:min(420px,100%);height:100vh;background:white;z-index:10;padding:100px 30px 30px;box-shadow:-10px 0 30px rgba(0,0,0,.1);transition:.3s}.cart.open{right:0}.close{position:absolute;top:20px;right:25px;font-size:36px}.cart-item{padding:16px 0;border-bottom:1px solid #eee;display:flex;justify-content:space-between}.cart-footer{position:absolute;bottom:30px;left:30px;right:30px;display:grid;gap:15px}.empty{color:#657171}@media(max-width:700px){header{padding:0 5%}nav{gap:14px}.hero{background:#101313}.section-head,.about{display:block}.products{grid-template-columns:1fr}.product{margin-bottom:30px}.about p:last-child{margin-top:40px}.section h2,.contact h2{font-size:50px}.hero h1,.about h2{letter-spacing:-3px}nav a{font-size:12px}}
